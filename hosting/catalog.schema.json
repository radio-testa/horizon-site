{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HORIZON catalogo web Stable v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "current",
    "releases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "channel": {
      "const": "stable"
    },
    "current": {
      "type": [
        "string",
        "null"
      ]
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "tag",
          "technicalVersion",
          "buildId",
          "channel",
          "title",
          "notes",
          "publishedAt",
          "releaseId",
          "status",
          "provenance",
          "installer"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "tag": {
            "type": "string",
            "pattern": "^v\\d+\\.\\d+\\.\\d+$"
          },
          "technicalVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$"
          },
          "buildId": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "const": "stable"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "notes": {
            "type": "string",
            "maxLength": 32000
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "releaseId": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "const": "supported"
          },
          "provenance": {
            "type": "string",
            "format": "uri"
          },
          "installer": {
            "type": "object",
            "required": [
              "name",
              "bytes",
              "sha256",
              "url"
            ],
            "properties": {
              "name": {
                "const": "HORIZON_Setup.exe"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    }
  }
}
